# Drizzle
DATABASE_URL="postgres://root:mysecretpassword@localhost:5432/local"

# IA. Optionnel : sans ces variables, la génération déterministe du document fonctionne
# normalement, seule la rédaction assistée est indisponible.
#
# Mode 1, production : passerelle authentifiée devant l'IA du Mac Studio, joignable par Tailscale.
# Dès que ces deux variables sont fournies, elles ont priorité sur OLLAMA_URL.
# AI_API_URL="https://intebecs-mac-studio.tail7bd633.ts.net"
# AI_API_KEY=""
# AI_MODEL="gemma4:latest"

# Mode 2, développement : démon Ollama joint en direct, sans authentification.
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1:8b"

# Accès : rien à configurer ici. L'application n'a ni mot de passe ni comptes — elle n'écoute que
# sur la boucle locale et c'est `tailscale serve` qui la publie, aux seuls membres du tailnet.
# Voir la section « Accès » du README.

# Origine que Chromium visite pour imprimer le PDF. `compose.yaml` la renseigne pour les conteneurs ;
# en local, l'origine de la requête suffit. Indispensable dès qu'un proxy est devant l'application :
# sans elle, Chromium sortirait par le proxy pour revenir au même serveur.
# PDF_ORIGIN="http://127.0.0.1:5173"

# Adresse publique de l'application, en production uniquement (profil compose `prod`). SvelteKit
# compare l'en-tête `Origin` de chaque POST à cette valeur : si elle ne correspond pas exactement à
# l'URL vue par le navigateur, tout enregistrement de formulaire répond 403.
# ORIGIN="https://intebecs-mac-studio.tail7bd633.ts.net:8443"
