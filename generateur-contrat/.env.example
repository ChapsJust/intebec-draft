# Drizzle
DATABASE_URL="postgres://root:mysecretpassword@localhost:5432/local"

# IA. Optionnel : sans ces variables, la génération déterministe du document fonctionne
# normalement, seule la rédaction assistée est indisponible.
#
# Mode 1, production : passerelle authentifiée devant l'IA du Mac Studio, joignable par Tailscale.
# Dès que ces deux variables sont fournies, elles ont priorité sur OLLAMA_URL.
# AI_API_URL="https://intebecs-mac-studio.tail7bd633.ts.net"
# AI_API_KEY=""
# AI_MODEL="gemma4:latest"

# Mode 2, développement : démon Ollama joint en direct, sans authentification.
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1:8b"

# Accès. Obligatoire : sans ces deux variables, l'application refuse toute requête plutôt que de
# s'ouvrir à tout le monde. Une protection qu'on désactive en oubliant une variable n'en est pas une.
#
# Clé de signature des sessions, à générer une fois :  npm run auth:secret
AUTH_SECRET=""
#
# Comptes autorisés, au format "identifiant:sel:empreinte", séparés par des virgules.
# Une ligne par personne, à générer avec :  npm run auth:compte -- <identifiant> "<mot de passe>"
# Le mot de passe n'est jamais stocké, seulement son empreinte scrypt salée.
AUTH_UTILISATEURS=""
