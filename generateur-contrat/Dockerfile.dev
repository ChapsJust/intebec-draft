# Image de développement : app SvelteKit + outils Drizzle + Chromium pour la génération PDF.
FROM node:22-alpine

WORKDIR /app

# Chromium vient du gestionnaire de paquets d'Alpine et pas de Playwright : les binaires que
# Playwright télécharge sont liés à la glibc et refusent de démarrer sur musl. `CHROMIUM_PATH` dit
# à `pdf.ts` où le trouver, et lui sert du même coup à savoir qu'il tourne en conteneur.
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
ENV CHROMIUM_PATH=/usr/bin/chromium-browser

RUN apk add --no-cache \
	chromium \
	nss \
	freetype \
	harfbuzz \
	ca-certificates \
	ttf-freefont \
	font-noto

# Copiés seuls, avant le reste : la couche est réutilisée telle quelle tant que package*.json ne
# change pas, donc `npm ci` ne tourne pas à chaque rebuild.
COPY package.json package-lock.json ./
RUN npm ci

# En dev ce code est aussitôt recouvert par le volume de compose ; il n'est là que pour le build
# de production, qui tourne sans volume.
COPY . .

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
