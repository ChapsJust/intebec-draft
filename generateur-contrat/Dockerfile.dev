# Image de développement : app SvelteKit + outils Drizzle + Chromium pour la génération PDF.
FROM node:22-alpine

WORKDIR /app

# Installe les dépendances système nécessaires pour Chromium et Drizzle et pour la génération de PDF.
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
ENV CHROMIUM_PATH=/usr/bin/chromium-browser

# Installe Chromium et ses dépendances pour la génération de PDF.
RUN apk add --no-cache \
	chromium \
	nss \
	freetype \
	harfbuzz \
	ca-certificates \
	ttf-freefont \
	font-noto

# Installe les dépendances en couche cachée (relancée seulement si package*.json change).
COPY package.json package-lock.json ./
RUN npm ci

# Le reste du code est monté en volume par compose en dev 
COPY . .

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
