# Image de développement : app SvelteKit + outils Drizzle + Chromium pour la génération PDF.
FROM node:22-alpine

WORKDIR /app
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
ENV CHROMIUM_PATH=/usr/bin/chromium-browser

RUN apk add --no-cache \
	chromium \
	nss \
	freetype \
	harfbuzz \
	ca-certificates \
	ttf-freefont \
	font-noto
	
# Installation de Playwright pour Chromium
COPY package.json package-lock.json ./
RUN npm ci

# En dev ce code est aussitôt recouvert par le volume de compose ; il n'est là que pour le build
# de production, qui tourne sans volume.
COPY . .

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
